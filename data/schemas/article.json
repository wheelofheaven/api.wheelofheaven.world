{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.wheelofheaven.world/v1/schema/article/",
  "title": "Article",
  "description": "A long-form essay / explainer. Returned by /v1/articles/{slug}/.",
  "type": "object",
  "required": ["slug", "title", "description", "body_html"],
  "properties": {
    "slug": {"type": "string"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "category": {"type": "string"},
    "claim_type": {"type": "string", "enum": ["direct", "inferred", "speculative", ""]},
    "editorial_pass": {"type": "string", "pattern": "^([0-9]{4}-[0-9]{2})?$"},
    "translation_status": {"type": "string", "enum": ["en_only", "partial", "complete"]},
    "summary": {"type": "string"},
    "tldr": {"type": "string"},
    "claims": {"type": "array", "description": "Inline claim markers in the body: the assertions the page labels, each with its epistemic label and, where one controls it, the core claim record. The same spans appear in body_html as <span class=\"claim\" data-claim-type data-claim-id>.", "items": {"type": "object", "required": ["label", "text"], "properties": {"label": {"type": "string", "enum": ["direct", "framework", "inferred", "speculative"]}, "text": {"type": "string", "description": "The labelled assertion as plain text."}, "id": {"type": "string", "pattern": "^woh-claim-\\d{4}$", "description": "Core claim record id."}, "record": {"type": "string", "format": "uri", "description": "The core claim record (JSON)."}}}},
    "body_html": {"type": "string"},
    "extra": {"type": "object"}
  }
}
