{%- set tid = page.extra.tradition_id -%}
{%- set lang = page.extra.lang | default(value="en") -%}
{%- set lang_prefix = page.extra.lang_prefix | default(value="") -%}
{%- set catalog = load_data(path="data/library/catalog.json") -%}
{%- set_global tradition_entry = false -%}
{%- for t in catalog.traditions -%}
  {%- if t.id == tid -%}
    {%- set_global tradition_entry = t -%}
  {%- endif -%}
{%- endfor -%}
{%- if tradition_entry -%}
{%- set t_name = tid -%}
{%- if tradition_entry.name and tradition_entry.name[lang] -%}{%- set t_name = tradition_entry.name[lang] -%}
{%- elif tradition_entry.name and tradition_entry.name.en -%}{%- set t_name = tradition_entry.name.en -%}{%- endif -%}
{%- set t_desc = "" -%}
{%- if tradition_entry.description and tradition_entry.description[lang] -%}{%- set t_desc = tradition_entry.description[lang] -%}
{%- elif tradition_entry.description and tradition_entry.description.en -%}{%- set t_desc = tradition_entry.description.en -%}{%- endif -%}
{
  "apiVersion": "v1",
  "kind": "Tradition",
  "metadata": {
    "generated": "{{ now() | date(format="%Y-%m-%dT%H:%M:%SZ") }}",
    "language": "{{ lang }}",
    "id": "{{ tid }}"
  },
  "data": {
    "id": "{{ tradition_entry.id }}",
    "code": "{{ tradition_entry.code | default(value="") }}",
    "name": {{ t_name | json_encode | safe }},
    "description": {{ t_desc | json_encode | safe }},
    "order": {{ tradition_entry.order | default(value=999) }},
    "icon": "{{ tradition_entry.icon | default(value="") }}",
    "books": [
{%- set_global first = true -%}
{%- for book in catalog.books -%}
  {%- if book.tradition == tid and (lang == "en" or (book.availableLangs and lang in book.availableLangs)) -%}
    {%- if not first %},{% endif -%}
    {%- set_global first = false -%}
    {%- set b_title = book.slug -%}
    {%- if book.titles and book.titles[lang] -%}{%- set b_title = book.titles[lang] -%}
    {%- elif book.titles and book.titles.en -%}{%- set b_title = book.titles.en -%}{%- endif %}
      {
        "slug": "{{ book.slug }}",
        "code": "{{ book.code }}",
        "title": {{ b_title | json_encode | safe }},
        "primaryLang": "{{ book.primaryLang }}",
        "chapters": {{ book.chapters | default(value=0) }},
        "paragraphs": {{ book.paragraphs | default(value=0) }},
        "status": "{{ book.status | default(value="unknown") }}",
        "url": "/v1{{ lang_prefix }}/library/books/{{ book.slug }}/"
      }
  {%- endif -%}
{%- endfor %}
    ]
  },
  "links": {
    "self": "/v1{{ lang_prefix }}/library/traditions/{{ tid }}/",
    "traditions": "/v1{{ lang_prefix }}/library/traditions/",
    "library": "/v1{{ lang_prefix }}/library/",
    "books": "/v1{{ lang_prefix }}/library/books/"
  }
}
{%- else -%}
{
  "apiVersion": "v1",
  "kind": "Error",
  "error": {
    "code": 404,
    "message": "Tradition not found: {{ tid }}"
  }
}
{%- endif -%}
