{%- set lang = section.extra.lang | default(value="en") -%}
{%- set lang_prefix = section.extra.lang_prefix | default(value="") -%}
{%- set data_path = section.extra.data_path | default(value="data/extracted/articles.json") -%}
{%- set articles = load_data(path=data_path) -%}
{
  "apiVersion": "v1",
  "kind": "ArticleIndex",
  "metadata": {
    "generated": "{{ articles.generated }}",
    "language": "{{ lang }}",
    "count": {{ articles.count }},
    "schemaUrl": "/v1/schema/article/"
  },
  "data": [
{%- for entry in articles.entries %}
    {{ entry | json_encode(pretty=true) | indent(width=4) | safe }}{% if not loop.last %},{% endif %}
{%- endfor %}
  ],
  "links": {
    "self": "/v1{{ lang_prefix }}/articles/",
    "schema": "/v1/schema/article/"
  }
}
