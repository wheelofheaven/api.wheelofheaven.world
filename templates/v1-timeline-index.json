{%- set timeline = load_data(path="data/extracted/timeline.json") -%}
{
  "apiVersion": "v1",
  "kind": "TimelineIndex",
  "metadata": {
    "generated": "{{ timeline.generated }}",
    "count": {{ timeline.count }}
  },
  "entries": [
{%- for entry in timeline.entries %}
    {
      "slug": {{ entry.slug | json_encode() | safe }},
      "title": {{ entry.title | json_encode() | safe }},
      "description": {{ entry.description | json_encode() | safe }},
      "weight": {{ entry.weight }},
      "url": "/v1/timeline/{{ entry.slug }}"
      {%- if entry.extra %},
      "extra": {{ entry.extra | json_encode() | safe }}
      {%- endif %}
    }{% if not loop.last %},{% endif %}
{%- endfor %}
  ],
  "links": {
    "self": "/v1/timeline",
    "context": "/v1/context/timeline"
  }
}
