{%- set lang = section.extra.lang | default(value="en") -%}
{%- set lang_prefix = section.extra.lang_prefix | default(value="") -%}
{%- set data_path = section.extra.data_path | default(value="data/extracted/timeline.json") -%}
{%- set timeline = load_data(path=data_path) -%}
{
  "apiVersion": "v1",
  "kind": "TimelineIndex",
  "metadata": {
    "generated": "{{ timeline.generated }}",
    "language": "{{ lang }}",
    "count": {{ timeline.count }},
    "schemaUrl": "/v1/schema/timeline-entry/"
  },
  "data": [
{%- for entry in timeline.entries %}
    {{ entry | json_encode(pretty=true) | indent(width=4) | safe }}{% if not loop.last %},{% endif %}
{%- endfor %}
  ],
  "links": {
    "self": "/v1{{ lang_prefix }}/timeline/",
    "context": "/v1/context/timeline/",
    "schema": "/v1/schema/timeline-entry/"
  }
}
