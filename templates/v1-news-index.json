{%- set lang = section.extra.lang | default(value="en") -%}
{%- set lang_prefix = section.extra.lang_prefix | default(value="") -%}
{%- set data_path = section.extra.data_path | default(value="data/extracted/news.json") -%}
{%- set news = load_data(path=data_path) -%}
{
  "apiVersion": "v1",
  "kind": "NewsIndex",
  "metadata": {
    "generated": "{{ news.generated }}",
    "language": "{{ lang }}",
    "count": {{ news.count }},
    "schemaUrl": "/v1/schema/dispatch/"
  },
  "data": [
{%- for entry in news.entries %}
    {{ entry | json_encode(pretty=true) | indent(width=4) | safe }}{% if not loop.last %},{% endif %}
{%- endfor %}
  ],
  "links": {
    "self": "/v1{{ lang_prefix }}/news/",
    "schema": "/v1/schema/dispatch/"
  }
}
