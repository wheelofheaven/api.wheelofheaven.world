{%- import "macros/edges.html" as edges -%}
{%- set slug = page.slug -%}
{%- set lang = page.extra.lang | default(value="en") -%}
{%- set lang_prefix = page.extra.lang_prefix | default(value="") -%}
{
  "apiVersion": "v1",
  "kind": "TimelineEntry",
  "metadata": {
    "generated": "{{ now() | date(format='%Y-%m-%dT%H:%M:%SZ') }}",
    "language": "{{ lang }}",
    "schemaUrl": "/v1/schema/timeline-entry/"
  },
  "data": {
    "slug": {{ slug | json_encode | safe }},
    "title": {{ page.title | json_encode | safe }},
    "description": {{ page.description | json_encode | safe }},
    "weight": {{ page.extra.weight | default(value=0) }},
    "symbol": {{ page.extra.symbol | default(value="") | json_encode | safe }},
    "color": {{ page.extra.color | default(value="") | json_encode | safe }},
    "zodiac_sign": {{ page.extra.zodiac_sign | default(value="") | json_encode | safe }},
    "start_year": {{ page.extra.start_year | default(value="") | json_encode | safe }},
    "end_year": {{ page.extra.end_year | default(value="") | json_encode | safe }},
    "genesis_day": {{ page.extra.genesis_day | default(value=0) }},
    "genesis_verse": {{ page.extra.genesis_verse | default(value="") | json_encode | safe }},
    "claim_type": {{ page.extra.claim_type | default(value="") | json_encode | safe }},
    "editorial_pass": {{ page.extra.editorial_pass | default(value="") | json_encode | safe }},
    "translation_status": {{ page.extra.translation_status | default(value="en_only") | json_encode | safe }},
    "body_html": {{ page.content | json_encode | safe }},
    "extra": {% if page.extra %}{{ page.extra | json_encode | safe }}{% else %}{}{% endif %}
  },
  "links": {
    "self": "/v1{{ lang_prefix }}/timeline/{{ slug }}/",
    "canonical_html": "https://www.wheelofheaven.world{{ lang_prefix }}/timeline/{{ slug }}/",
    "index": "/v1{{ lang_prefix }}/timeline/",
    "schema": "/v1/schema/timeline-entry/",
    "related": {{ edges::related_from_see_also(see_also=page.extra.see_also | default(value=[]), lang_prefix=lang_prefix) | safe }}
  }
}
