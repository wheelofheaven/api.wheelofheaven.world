{%- set slug = page.slug -%}
{
  "apiVersion": "v1",
  "kind": "TraditionHub",
  "metadata": {
    "generated": "{{ now() | date(format='%Y-%m-%dT%H:%M:%SZ') }}",
    "language": "en",
    "schemaUrl": "/v1/schema/tradition-hub/"
  },
  "data": {
    "slug": {{ slug | json_encode | safe }},
    "title": {{ page.title | json_encode | safe }},
    "description": {{ page.description | json_encode | safe }},
    "source_family": {{ page.extra.source_family | default(value="") | json_encode | safe }},
    "claim_type": {{ page.extra.claim_type | default(value="") | json_encode | safe }},
    "translation_status": {{ page.extra.translation_status | default(value="en_only") | json_encode | safe }},
    "body_html": {{ page.content | json_encode | safe }},
    "extra": {% if page.extra %}{{ page.extra | json_encode | safe }}{% else %}{}{% endif %}
  },
  "links": {
    "self": "/v1/sources/traditions/{{ slug }}/",
    "canonical_html": "https://www.wheelofheaven.world/sources/tradition/{{ slug }}/",
    "index": "/v1/sources/traditions/",
    "schema": "/v1/schema/tradition-hub/"
  }
}
