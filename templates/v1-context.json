  "metadata": {
    "generated": "{{ now() | date(format="%Y-%m-%dT%H:%M:%SZ") }}",
    "purpose": "LLM/AI context for understanding Wheel of Heaven"
  },
  "data": {
    "project": {
      "name": "Wheel of Heaven",
      "tagline": "An encyclopedic encyclopedia of Ages past, present and future",
      "url": "https://www.wheelofheaven.io",
      "description": "Wheel of Heaven is a comprehensive knowledge base exploring the hypothesis that life on Earth was intelligently designed by an extraterrestrial civilization known as the Elohim. The project synthesizes Raëlian teachings, biblical exegesis, ancient astronaut theory, and archaeoastronomy into a coherent narrative spanning cosmic time.",
      "license": "CC0-1.0 (Public Domain)",
      "languages": ["en", "fr", "de", "es", "ja", "ko", "ru", "zh", "zh-Hant"]
    },
    "coreHypothesis": {
      "summary": "Life on Earth was created through advanced genetic engineering by an extraterrestrial civilization called the Elohim, who were mistaken for gods by ancient humans.",
      "keyPoints": [
        "The Elohim are a scientifically advanced extraterrestrial civilization",
        "They created all life on Earth through genetic engineering approximately 25,000 years ago",
        "Biblical and ancient texts are historical accounts of their interactions with humanity",
        "The word 'Elohim' in Hebrew is plural, meaning 'those who came from the sky'",
        "Humanity is approaching a new age (Age of Aquarius) of potential reconnection with our creators"
      ],
      "precessionalCycle": {
        "description": "The 25,920-year cycle of Earth's axial precession, divided into 12 'World Ages' of ~2,160 years each",
        "currentAge": "Age of Aquarius (began ~1945 CE)",
        "significance": "Each age marks a phase in humanity's relationship with the Elohim"
      }
    },
    "traditions": [
{%- for tradition in catalog.traditions %}
