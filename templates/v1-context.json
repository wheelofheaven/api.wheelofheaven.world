        "id": "{{ tradition.id }}",
        "name": {% if tradition.name %}{{ tradition.name | json_encode() | safe }}{% else %}{}{% endif %},
        "description": {% if tradition.description %}{{ tradition.description | json_encode() | safe }}{% else %}{}{% endif %}
      }{% if not loop.last %},{% endif %}
{%- endfor %}
    ],
    "keyTerminology": [
      {
        "term": "Elohim",
        "definition": "Hebrew plural noun meaning 'those who came from the sky'. In the Wheel of Heaven interpretation, this refers to the extraterrestrial creators of life on Earth."
      },
      {
        "term": "Raël",
        "definition": "Born Claude Vorilhon (1946-), French author who founded the Raëlian Movement after claiming contact with the Elohim in 1973."
      },
      {
        "term": "World Age",
        "definition": "A ~2,160-year period corresponding to the zodiacal age determined by axial precession. Currently transitioning from Pisces to Aquarius."
      },
      {
        "term": "Precession of the Equinoxes",
        "definition": "The 25,920-year cycle during which Earth's rotational axis traces a circle against the backdrop of stars, causing the zodiacal ages."
      },
      {
        "term": "Ancient Astronaut Hypothesis",
        "definition": "The theory that extraterrestrial beings visited Earth in antiquity and influenced the development of human civilizations."
      },
      {
        "term": "Intelligent Design (in this context)",
        "definition": "The creation of life through deliberate genetic engineering by the Elohim, not through supernatural means or random evolution alone."
      }
    ],
    "contentSections": [
      {
        "name": "Wiki",
