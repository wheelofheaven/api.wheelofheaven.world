{%- set lang = section.extra.lang | default(value="en") -%}
{%- set lang_prefix = section.extra.lang_prefix | default(value="") -%}
{%- set data_path = section.extra.data_path | default(value="data/extracted/wiki.json") -%}
{%- set wiki = load_data(path=data_path) -%}
{
  "apiVersion": "v1",
  "kind": "WikiIndex",
  "metadata": {
    "generated": "{{ wiki.generated }}",
    "language": "{{ lang }}",
    "count": {{ wiki.count }},
    "schemaUrl": "/v1/schema/wiki-entry/"
  },
  "data": [
{%- for entry in wiki.entries %}
    {{ entry | json_encode(pretty=true) | indent(width=4) | safe }}{% if not loop.last %},{% endif %}
{%- endfor %}
  ],
  "links": {
    "self": "/v1{{ lang_prefix }}/wiki/",
    "context": "/v1/context/",
    "schema": "/v1/schema/wiki-entry/",
    "search": "/v1/search/"
  }
}
