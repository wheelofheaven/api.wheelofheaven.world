{% set catalog = load_data(path="data/library/catalog.json") -%}
{
  "apiVersion": "v1",
  "kind": "TraditionList",
  "metadata": {
    "generated": "{{ now() | date(format="%Y-%m-%dT%H:%M:%SZ") }}"
  },
  "data": {{ catalog.traditions | json_encode(pretty=true) | safe }},
  "links": {
    "self": "/v1/traditions/",
    "canonical": "/v1/library/traditions/",
    "library": "/v1/library/"
  }
}
