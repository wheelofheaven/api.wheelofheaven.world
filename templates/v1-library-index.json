{%- set lang = section.extra.lang | default(value="en") -%}
{%- set lang_prefix = section.extra.lang_prefix | default(value="") -%}
{%- set catalog = load_data(path="data/library/catalog.json") -%}
{
  "apiVersion": "v1",
  "kind": "LibraryOverview",
  "metadata": {
    "generated": "{{ now() | date(format='%Y-%m-%dT%H:%M:%SZ') }}",
    "language": "{{ lang }}",
    "schemaUrl": "/v1/schema/library/"
  },
  "data": {
    "version": "{{ catalog.version | default(value='1.0') }}",
    "totalBooks": {{ catalog.books | length }},
    "totalTraditions": {{ catalog.traditions | length }}
  },
  "links": {
    "self": "/v1{{ lang_prefix }}/library/",
    "books": "/v1{{ lang_prefix }}/library/books/",
    "traditions": "/v1{{ lang_prefix }}/library/traditions/",
    "schema": "/v1/schema/library/"
  }
}
