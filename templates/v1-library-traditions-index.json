{%- set lang = section.extra.lang | default(value="en") -%}
{%- set lang_prefix = section.extra.lang_prefix | default(value="") -%}
{%- set catalog = load_data(path="data/library/catalog.json") -%}
{
  "apiVersion": "v1",
  "kind": "TraditionList",
  "metadata": {
    "generated": "{{ now() | date(format="%Y-%m-%dT%H:%M:%SZ") }}",
    "language": "{{ lang }}",
    "count": {{ catalog.traditions | length }}
  },
  "data": [
{%- for tradition in catalog.traditions %}
{%- set t_name = tradition.id -%}
{%- if tradition.name and tradition.name[lang] -%}{%- set t_name = tradition.name[lang] -%}
{%- elif tradition.name and tradition.name.en -%}{%- set t_name = tradition.name.en -%}{%- endif -%}
{%- set t_desc = "" -%}
{%- if tradition.description and tradition.description[lang] -%}{%- set t_desc = tradition.description[lang] -%}
{%- elif tradition.description and tradition.description.en -%}{%- set t_desc = tradition.description.en -%}{%- endif -%}
    {
      "id": "{{ tradition.id }}",
      "code": "{{ tradition.code | default(value="") }}",
      "name": {{ t_name | json_encode | safe }},
      "names": {% if tradition.name %}{{ tradition.name | json_encode() | safe }}{% else %}{}{% endif %},
      "description": {{ t_desc | json_encode | safe }},
      "descriptions": {% if tradition.description %}{{ tradition.description | json_encode() | safe }}{% else %}{}{% endif %},
      "order": {{ tradition.order | default(value=999) }},
      "icon": "{{ tradition.icon | default(value="") }}",
      "links": {
        "self": "/v1{{ lang_prefix }}/library/traditions/{{ tradition.id }}/"
      }
    }{% if not loop.last %},{% endif %}
{%- endfor %}
  ],
  "links": {
    "self": "/v1{{ lang_prefix }}/library/traditions/",
    "library": "/v1{{ lang_prefix }}/library/",
    "books": "/v1{{ lang_prefix }}/library/books/",
    "alias": "/v1{{ lang_prefix }}/traditions/"
  }
}
